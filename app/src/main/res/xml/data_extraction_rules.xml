<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup: the library database, settings and cover photos go to the
     user's Google backup and transfer to a new phone. Caches are left out. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
