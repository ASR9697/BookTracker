<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview for the Reading session widget (sample content). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="72dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_preview_cover_alt" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reading now"
                android:textColor="#FFF59E0B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24:18"
                android:textColor="#FFF4EDE1"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="p. 52 / 329 · +12"
                android:textColor="#FFB9B1C0"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_preview_progress" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/widget_preview_pill"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Pause"
            android:textColor="#FFF4EDE1"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_preview_pill"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="+1"
            android:textColor="#FFF4EDE1"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_pill_accent"
            android:gravity="center"
            android:text="Finish"
            android:textColor="#FF1F1B24"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
