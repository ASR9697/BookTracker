<?xml version="1.0" encoding="utf-8"?>
<!-- The reading widget's live clock: a Chronometer ticks on its own, so the widget needn't redraw every second. -->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_chronometer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textSize="22sp"
    android:textStyle="bold" />
