<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview for the Up next widget (sample content). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="HardcodedText">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Up next"
        android:textColor="#FFF4EDE1"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="72dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_preview_cover" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="72dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_preview_cover_alt" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="72dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_preview_cover" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="72dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_preview_cover_alt" />
    </LinearLayout>
</LinearLayout>
